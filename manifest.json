{
  "manifest_version": 3,
  "name": "YouTube Classic Theater Mode",
  "version": "1.2.0",
  "description": "Disable the Oct 2026 side-rail watch UI and restore classic Theater Mode layout on YouTube desktop.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://youtube.com/*"],
      "js": ["content/patch-flags.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://www.youtube.com/*", "*://youtube.com/*"],
      "css": ["styles/classic-theater.css"],
      "js": ["content/classic-theater.js"],
      "run_at": "document_start"
    }
  ]
}
